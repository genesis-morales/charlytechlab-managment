# ==========================
# BASE DE DATOS
# ==========================
# Pooled connection (Neon: el que termina en -pooler) — para la app en runtime
DATABASE_URL=
# Direct connection (Neon: el que NO termina en -pooler) — para migraciones de Prisma
DIRECT_URL=

# ==========================
# AUTENTICACION
# ==========================
# Generar un secreto aleatorio de al menos 32 bytes; no reutilizar contraseñas.
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# ==========================
# ADMIN INICIAL (solo para seed)
# ==========================
ADMIN_EMAIL=
# Mínimo 12 caracteres; máximo 72 bytes UTF-8 (límite de bcrypt).
ADMIN_PASSWORD=
ADMIN_NAME="Administrador"

# ==========================
# CLOUDINARY (imagenes)
# ==========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================
# CONFIGURACION DEL SERVIDOR
# ==========================
PORT=3001
NODE_ENV="development"
TRUST_PROXY_HOPS=0
FRONTEND_URL="http://localhost:5173"

# ==========================
# RESERVAS (horas antes de expirar)
# ==========================
RESERVATION_HOLD_HOURS=48
